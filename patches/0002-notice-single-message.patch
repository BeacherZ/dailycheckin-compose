+
+
+# 各站点签到结果之间的分隔行。用全角破折号：所有推送渠道都能正常显示，
+# 不会被当成 markdown 语法，也不会像方块字符那样在不同字体下变成乱码。
+SEPARATOR = "\n" + "—" * 22 + "\n"
+
+
+def _as_bool(value, default: bool) -> bool:
+    """把配置里的真假值解析成 bool。
+
+    config.json 里 `MERGE_PUSH` 常常是空字符串（面板生成的空模板就是 ""），
+    而 `"" is None` 为假 —— 原来的 `if merge_push is None` 判断会因此走进
+    「不合并」分支，把一条通知拆成好几条发出去。这里统一把空值当默认值。
+    """
+    if value is None:
+        return default
+    text = str(value).strip().lower()
+    if text == "":
+        return default
+    return text not in ("0", "false", "no", "off", "none", "null")
 
 
